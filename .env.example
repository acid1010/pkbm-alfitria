# Copy this file to .env.local for local development or .env on the VPS.
# Never commit either copied file.

# -----------------------------------------------------------------------------
# Database — required in every environment
# -----------------------------------------------------------------------------
# Local PostgreSQL example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pkbm_alfitria?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pkbm_alfitria?schema=public"

# VPS PostgreSQL example — replace the two values above when using a remote DB:
# DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/pkbm_alfitria?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@DB_HOST:5432/pkbm_alfitria?schema=public"

# -----------------------------------------------------------------------------
# Auth and public URL — required in every environment
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Local:
NEXTAUTH_URL="http://localhost:3000"
# VPS:
# NEXTAUTH_URL="https://your-domain.example"

# -----------------------------------------------------------------------------
# Supabase can still be used for PostgreSQL, but Supabase Storage is not required.
# -----------------------------------------------------------------------------
# Private attendance selfie storage
# -----------------------------------------------------------------------------
# Local default. The directory is ignored by Git.
SELFIE_UPLOAD_DIR="./data/selfies"

# VPS: replace the local value with a persistent directory outside the public web root.
# SELFIE_UPLOAD_DIR="/var/lib/pkbm-alfitria/selfies"

# -----------------------------------------------------------------------------
# Private PPDB document storage
# -----------------------------------------------------------------------------
# Local default. The directory is ignored by Git.
PPDB_UPLOAD_DIR="./data/ppdb-uploads"

# VPS: replace the local value with a persistent directory outside the public web root.
# PPDB_UPLOAD_DIR="/var/lib/pkbm-alfitria/ppdb-uploads"

# -----------------------------------------------------------------------------
# Development/import-only secrets
# -----------------------------------------------------------------------------
# Required by `npm run db:seed`; never run the seed in production.
SEED_SUPERUSER_PASSWORD="replace-with-a-strong-admin-seed-password"
SEED_DEFAULT_PASSWORD="replace-with-a-strong-fixture-password"

# Required by `npx tsx prisma/import-siswa.ts`.
IMPORT_STUDENT_PASSWORD="replace-with-a-strong-import-password"

# -----------------------------------------------------------------------------
# Optional VPS process settings
# -----------------------------------------------------------------------------
# HOSTNAME="0.0.0.0"
# PORT="3000"
